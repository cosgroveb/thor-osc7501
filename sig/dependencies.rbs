# Dependency APIs used by the adapter that are absent from bundled RBS.
class Thor
  module OSC7501
    interface _Command
      def name: () -> String
    end

    # Self type for the generated hook module (rbs-inline cannot emit it):
    # the prepended module's instances are Thor commands.
    module CommandHook : _Command
    end
  end

  class Command
    attr_reader name: String
  end

  class Runner
    def self.all_commands: () -> Hash[String, Command]
  end

  def self.all_commands: () -> Hash[String, Command]

  module Base
    def self.subclasses: () -> Array[Class]
  end

  class Shell
    class Basic
      def ask: (untyped statement, *untyped args) ?{ (*untyped) -> untyped } -> untyped
    end
  end
end

module Gem
  class BasicSpecification
    def full_gem_path: () -> String
    def cache_file: () -> String
  end

  class Specification
    def self.find_all_by_name: (String) -> Array[Specification]
    def self.attribute_names: () -> Array[Symbol]
    def self.any?: () -> bool
                 | () { (Specification) -> boolish } -> bool
    def bindir: () -> String
    def name: () -> String
  end

  class Package
    def initialize: (String) -> void
    def verify: () -> bool
    def spec: () -> Specification

    class TarReader
      include Enumerable[Entry]
      def self.new: [T] (IO | StringIO) { (TarReader) -> T } -> T
      def each: () { (Entry) -> void } -> void

      class Entry
        def full_name: () -> String
        def read: () -> String
        def header: () -> TarHeader
      end
    end

    class TarHeader
      def typeflag: () -> String
      def mode: () -> Integer
      def linkname: () -> String
    end
  end
end

module Open3
  def self.capture3: (*String, ?stdin_data: String, ?chdir: String) -> [String, String, Process::Status]
                  | (Hash[String, String?], *String, ?stdin_data: String, ?chdir: String) -> [String, String, Process::Status]
                  | ...
end

module Zlib
  class GzipReader
    def self.wrap: [T] (StringIO) { (GzipReader) -> T } -> T
  end
end
